# Все значения имеют разумные умолчания прямо в docker-compose.yml —
# этот файл нужен, только если хочется что-то переопределить:
#   cp .env.example .env

# Порт, на котором приложение доступно снаружи.
CLIENT_PORT=8080

# Период имитации живых данных, мс. 0 — выключить поток обновлений.
TICK_INTERVAL_MS=3000

# 1 — включить отладочные параметры запроса (?delay, ?fail, ?empty, ?invalid).
MOCK_DEBUG=0

# Ключ для AI-поиска. Без него поиск работает как обычный текстовый (ADR 007).
ANTHROPIC_API_KEY=
# Модель должна поддерживать output_config.effort — это 4.6 и новее (ADR 007).
AI_MODEL=claude-sonnet-5
AI_TIMEOUT_MS=8000
